rules_version = '2';

// ============================================================
//  Shift — Firestore Security Rules
//  Agents can only touch their OWN records. Admins can read all.
//  Deploy: paste into Firebase Console -> Firestore -> Rules,
//  or run `firebase deploy --only firestore:rules`.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Always-admins by email. KEEP IN SYNC with SUPER_ADMIN_EMAILS in config.js.
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email in ['silvio.g@incfile.com'];
    }
    function isAdmin() {
      return isSuperAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    function ownsIncoming() {
      return isSignedIn() && request.resource.data.user_id == request.auth.uid;
    }
    function ownsExisting() {
      return isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    // ---- Users ----
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // First login creates the profile. New users must start as 'agent'
      // so nobody can self-promote to admin.
      allow create: if isOwner(userId) && request.resource.data.role == 'agent';

      // Owner may update their own profile but NOT their role.
      // Admins may update anything (including promoting/demoting roles).
      allow update: if isAdmin()
        || (isOwner(userId) && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    // ---- Time sessions ----
    match /sessions/{id} {
      allow read:          if isAdmin() || ownsExisting();
      allow create:        if ownsIncoming();
      allow update, delete:if ownsExisting();
    }

    // ---- Lunch sessions ----
    match /lunches/{id} {
      allow read:          if isAdmin() || ownsExisting();
      allow create:        if ownsIncoming();
      allow update, delete:if ownsExisting();
    }

    // ---- Activities ----
    match /activities/{id} {
      allow read:          if isAdmin() || ownsExisting();
      allow create:        if ownsIncoming();
      allow update, delete:if ownsExisting();
    }

    // ---- Tasks (admin assigns; assignee reports back) ----
    match /tasks/{id} {
      allow read:          if isAdmin() || (isSignedIn() && resource.data.assigned_to == request.auth.uid);
      allow create, delete:if isAdmin();
      // The assignee may update their own task's status/notes, but cannot
      // reassign it or rewrite the title/assigner.
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.assigned_to == request.auth.uid
            && request.resource.data.assigned_to == resource.data.assigned_to
            && request.resource.data.assigned_by == resource.data.assigned_by
            && request.resource.data.title == resource.data.title);
    }
  }
}
